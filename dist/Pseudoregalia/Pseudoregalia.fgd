// === Pseudoregalia.fgd ===
//
// Above each entity definition, a measurement of the actor's relevant
// collision is recorded in UE units.

@baseclass size(-8 -8 0, 8 8 16) = BottomAnchor []

@SolidClass = worldspawn : "World entity" []

// === BP_PlayerGoatMain ======================================================
//   * Capsule half height: 65
//   * Capsule side radius: 22
// ============================================================================
@PointClass size(-7 -7 -21, 7 7 21) color(0 255 0) = info_player_start : "

If you specify 'tag', you can target it from a save_point.

If you have the quickstart mod installed, you can also start the game with '-spawn=<targetname>' on the command line to spawn there on game start.

"
[
    tag(target_source) : "Tag"
    angle(integer) : "Direction. Default is 0 (+X)"
]

// === BP_NPC =================================================================
//   * Capsule relative location: 0, 0, 0
//   * Capsule half height: 33
//   * Capsule side radius: 20
// ============================================================================
@PointClass size(-7 -7 -11, 7 7 11) = npc_goatling : "

Goatling.

"
[]

// === BP_SavePoint ===========================================================
//   * Box relative location: 0, 0, 107.400539
//   * Box extents: 32, 32, 110
// ============================================================================
@PointClass size(-10 -10 0, 10 10 70) color(128 255 255) = misc_save_point : "

You can target a player_start by putting its 'tag' into this entity's 'target' property.

"
[
    target(target_destination) : "Target (player_start)"
]

// === BP_JumpBubble ==========================================================
//   * Sphere relative location: 0, 0, 0
//   * Sphere radius: 130
// ============================================================================
@PointClass size(-42 -42 -42, 42 42 42) color(255 127 255) = misc_jump_bubble :
    "Jump bubble."
[]

// === BP_UpgradeBase =========================================================
//   * Sphere relative location: 0, 0, 100
//   * Sphere radius: 60
// ============================================================================
@PointClass size(-16 -16 16, 16 16 48) color(200 200 200) = item_upgrade : "

Upgrade pickup.

"
[
    upgrade(choices) : "Upgrade" : "attack" : "" =
    [
        "attack" : "Dream Breaker"
        "wallRide" : "Cling Gem"
        "airKick" : "Sun Greaves"
        "slide" : "Slide"
        "Light" : "Ascendant Light"
        "SlideJump" : "Solar Wind"
        "plunge" : "Sunsetter"
        "projectile" : "Soul Cutter"
        "powerBoost" : "Indignation"
        "chargeAttack" : "Strikebreak"
        "extraKick" : "Heliacal Power"
    ]
    quick_pickup(boolean) : : 1 : "Skip game-pausing upgrade pickup dialog."
]

// === BP_Hazard (custom) =====================================================
//   * Takes the exact form of the brush.
// ============================================================================
@SolidClass = trigger_hazard_zone : "

Upon collision, player is warped back to last touched safe_zone.

"
[]

// === BP_SafeZone (custom) ===================================================
//   * Uses the axis-aligned bounding box of the brush.
// ============================================================================
@SolidClass = trigger_safe_zone : "

Functions as a soft invisible checkpoint. Upon collision with a hazard_zone, player is warped back to last touched safe_zone. On death or reload, this state is not preserved.

Can target a respawn_anchor if respawn location needs to be tweaked. If no target is specified, the center-bottom of the safe_zone's axis-aligned bounding box is used.

Due to UE collision limitations, arbitrary brush shapes are not supported. The axis-aligned bounding box of the brush will be used. This could be improved in the future to allow the bounding box to have arbitrary angles, but at the end of the day it probably has to be a box collider on the UE end.

"
[
    target(target_destination) : "Target (respawn_anchor)"
]

// === Respawn anchor (custom) ================================================
//   * Part of another custom actor: BP_SafeZone
// ============================================================================
@PointClass base(BottomAnchor) = info_respawn_anchor : "

Used to tweak respawn location associated with a safe_zone.

"
[
    tag(target_source) : "Tag"
]

// === SM_StarterGate (custom) ================================================
//   * Custom static mesh with actual UVs.
//     * (Other meshes in the game seem to use global coordinates as UVs.)
//   * Mesh and texture originally created by turncoda for map_starter.
//   * Origin: Center-bottom
//   * Dimensions: 20, 400, 600
// ============================================================================
@PointClass base(BottomAnchor) model({"path": "gate.obj"}) = prop_gate : "

A fixed-size gate. Not from the base game.

Can be rotated using the angles property.

Can be designated as 'child' to an info_parent, so as to be switch-activated.

"
[
    angles(angle) : "Pitch Yaw Roll (Y Z X)" : "0 0 0"
    tag(target_source) : "target with info_parent"
]

@PointClass = info_parent : "

A container for 'child' (can be a prop_gate or func_movable).

Target this with a func_switch. On switch activation, moves to the info_marker specified by 'destination', carrying 'child' along with it (maintaining its relative transform).

"
[
    destination(target_destination) : "info_marker"
    child(target_destination) : "prop_gate/func_movable"
    tag(target_source) : "target from a func_switch"
]

@PointClass = info_marker : "

Marks a target location and orientation for an info_parent.

"
[
    angles(angle) : "Pitch Yaw Roll (Y Z X)" : "0 0 0"
    tag(target_source) : "target from an info_parent"
]

@SolidClass = func_movable : "

Can be designated as 'child' to an info_parent, so as to be switch-activated.

"
[
    tag(target_source) : "target with info_parent"
]

@PointClass base(BottomAnchor) = func_switch : "

Triggers an info_parent to move when hit.

"
[
    target(target_destination) : "info_parent"
]
