@SolidClass = worldspawn : "World entity" []

@baseclass size(-16 -16 -24, 16 16 32) color(0 255 0) = PlayerClass []
@baseclass size(-16 -16 -24, 16 16 32) color(0 255 255) = SaveClass []

@PointClass base(PlayerClass) = info_player_start :
    "If you specify 'tag', you can target it from a save_point. " +
    "You can also start the game with '-spawn=<targetname>' on the command " +
    "line (using the quickstart mod) to spawn there on game start."
[
    tag(target_source) : "Tag"
    angle(integer) : "Direction. Default is 0 (+X)"
]

@PointClass = info_respawn_anchor :
    "Used to tweak respawn location associated with a safe_zone."
[
    tag(target_source) : "Tag"
]

@PointClass base(SaveClass) = misc_save_point :
    "You can target a player_start by putting its 'tag' into this " +
    "entity's 'target' property."
[
    target(target_destination) : "Target (player_start)"
]

@PointClass = misc_jump_bubble : "Jump bubble." []
@PointClass = item_upgrade :
    "Upgrade pickup."
[
    upgrade(choices) : "Upgrade" : "attack" : "" =
    [
        "attack" : "Dream Breaker"
        "wallRide" : "Cling Gem"
        "airKick" : "Sun Greaves"
        "slide" : "Slide"
        "Light" : "Ascendant Light"
        "SlideJump" : "Solar Wind"
        "plunge" : "Sunsetter"
        "projectile" : "Soul Cutter"
        "powerBoost" : "Indignation"
        "chargeAttack" : "Strikebreak"
        "extraKick" : "Heliacal Power"
    ]
    quick_pickup(boolean) : : 1 : "Skip game-pausing upgrade pickup dialog."
]

@SolidClass = trigger_hazard_zone :
    "Upon collision, player is warped back to last touched safe_zone."
[]

@SolidClass = trigger_safe_zone :
    "Functions as a soft invisible checkpoint. Upon collision with a " +
    "hazard_zone, player is warped back to last touched safe_zone. " +
    "State is not preserved on reload." +
    "Can target a respawn_anchor if respawn location needs to be tweaked."
[
    target(target_destination) : "Target (respawn_anchor)"
]
